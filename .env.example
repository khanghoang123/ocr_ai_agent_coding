# ============================================================
# Environment Variables Template
# Copy this file to `.env` and fill in your actual values.
# NEVER commit `.env` to Git.
# ============================================================

# ----- Google Cloud / Vertex AI -----
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service_account.json

# ----- Gemini API (alternative to Vertex AI) -----
GEMINI_API_KEY=your-gemini-api-key-here

# ----- Local Paths (override in each environment) -----
# LOCAL: leave as default (relative to project root)
# COLAB: /content/drive/MyDrive/ocr_project
# KAGGLE: /kaggle/input/your-dataset-name
OCR_PROJECT_ROOT=.
OCR_DATA_DIR=./Dataset/data
OCR_CRAWLED_DIR=./data/crawled
OCR_PROCESSED_DIR=./data/processed
OCR_MODELS_DIR=./models
